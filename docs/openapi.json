    "/api/v1/sync/{slug}": {
      "post": {
        "summary": "Trigger Sync",
        "description": "手动触发单源站同步（后台执行，立即返回受理结果）。\n\n并发受全局闸门（SOURCE_SYNC_CONCURRENCY）限制：名额已满时任务进入排队，\n同一源站已在排队/运行时不会重复提交（返回 status=already_running）。",
        "operationId": "trigger_sync_api_v1_sync__slug__post",
        "parameters": [
          {
            "name": "slug",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Slug"
            }
          },
          {
            "name": "mode",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "pattern": "^(auto|full|incremental)$",
              "default": "auto",
