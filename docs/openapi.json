    "/api/v1/sources/auto-sync": {
      "post": {
        "summary": "Bulk Auto Sync",
        "description": "批量设置源站的「自动同步」开关（持久化，重启后仍生效）。\n\n关闭后该源站不再参与定时增量任务与全站同步，但手动单站同步不受影响。\n用法：\n  POST /api/v1/sources/auto-sync?enabled=false&slugs=all          全部暂停自动同步\n  POST /api/v1/sources/auto-sync?enabled=true&slugs=jkun,t1,bfzytv 只开启指定源站",
        "operationId": "bulk_auto_sync_api_v1_sources_auto_sync_post",
        "parameters": [
          {
            "name": "enabled",
            "in": "query",
            "required": true,
            "schema": {
              "type": "boolean",
              "description": "true=开启自动同步, false=暂停自动同步",
              "title": "Enabled"
            },
            "description": "true=开启自动同步, false=暂停自动同步"
          },
          {
            "name": "slugs",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "description": "逗号分隔的源站 slug 列表；all 或留空=全部源站",
              "default": "all",
              "title": "Slugs"
            },
            "description": "逗号分隔的源站 slug 列表；all 或留空=全部源站"
          },
          {
            "name": "apikey",
            "in": "query",
            "required": false,
