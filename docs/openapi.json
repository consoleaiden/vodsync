    "/api/v1/search": {
      "get": {
        "summary": "Aggregate Search",
        "description": "跨源站聚合搜索。\n\n实现说明：\n- 由于名称模糊匹配无法走索引，采用「每源站各查一次 + 并行执行 + 内存归并」策略，\n  避免一次性 UNION 全部表导致单条 SQL 扫描上千万行而超时；\n- 单个源站查询失败/超时不影响整体结果（返回 partial 标记与失败源站列表）；\n- 结果按 vod_time 倒序（新更新在前），可按 source 限定范围提升速度。",
        "operationId": "aggregate_search_api_v1_search_get",
        "parameters": [
          {
            "name": "wd",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64,
              "description": "影视名称关键词（必填）",
              "title": "Wd"
