# vodsync HTTPS 反向代理（Caddy）样例 —— v1.14.0 / B-09
#
# Caddy 的优势：自动申请/续期 Let's Encrypt 证书，不需要 certbot 与定时任务。
# 适合没有现成 Nginx 的部署；已有 Nginx 的用 deploy/nginx-vodsync.conf。
#
# 用法：
#   1. 把本文件内容并入 /etc/caddy/Caddyfile（或直接替换）
#   2. 把 vodsync.example.com 改成你的域名，确保 80/443 已放通且域名解析到本机
#   3. systemctl reload caddy
#   4. curl -sI https://vodsync.example.com/healthz | head -1     # 期望 200
#
# 明文 8181 由 docker-compose 的 ports 映射继续提供，与 HTTPS **并行**；
# 等确认所有客户端默认地址都改成 https 后，再考虑关掉 8181。

{
	# 邮件用于 Let's Encrypt 到期提醒（可留空，但出问题时收不到通知）
	email admin@example.com
	# 测试环境先用这行，避免反复申请触发 Let's Encrypt 速率限制
	# acme_ca https://acme-staging-v02.api.letsencrypt.org/directory
}

vodsync.example.com {
	# 反代到容器（Caddy 与容器同网络时用服务名；跑在宿主机则用 127.0.0.1:8181）
	reverse_proxy vodsync:8000 {
		# 鉴权头透传（Caddy 默认全透传，这里显式写出来是为了「改配置的人看得见」）
		header_up Authorization {http.request.header.Authorization}
		header_up X-API-Key {http.request.header.X-API-Key}
		header_up X-Client-Version {http.request.header.X-Client-Version}

		# 覆盖而非追加 XFF：否则客户端可伪造来源 IP，登录锁定失效
		header_up X-Forwarded-For {remote_host}
		header_up X-Forwarded-Proto {scheme}

		# 详情大响应（700+ 集）留足时间
		transport http {
			read_timeout 60s
			write_timeout 60s
			dial_timeout 10s
		}
	}

	# 压缩：play_lines 与 vod_play_list 同值双发，gzip 能压掉这份重复
	encode zstd gzip

	# TLS 1.2/1.3（Caddy 默认已是 1.2+，显式写出来避免以后被默认值变化带走）
	tls {
		protocols tls1.2 tls1.3
	}

	# HSTS：确认所有客户端默认地址已切 https 后再取消注释。
	# 下发后浏览器会强制 https，http 回退在浏览器里不可用（App 走 OkHttp 不受影响）。
	# header Strict-Transport-Security "max-age=31536000; includeSubDomains"

	# 健康检查不写访问日志
	log {
		output file /var/log/caddy/vodsync.log
		format console
	}
}
