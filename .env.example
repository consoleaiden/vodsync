# ===== 数据源 =====
# 资源站列表地址
LATEST_JSON_URL=https://mylazily.github.io/ziyuanzhan/data/latest.json
# 只同步 status=ok 的源站
ONLY_OK_SOURCES=true
# 发现新源站后立即全量同步
FULL_SYNC_ON_DISCOVER=true

# ===== 数据库（v1.7.0 起固定 PostgreSQL）=====
# 用户/密码/库名要与 docker-compose.yml 里的 postgres 服务一致。
# 直接容器部署（非 compose）时把 host 换成实际地址，例如 192.168.1.10:5432。
DATABASE_URL=postgresql+psycopg2://vodsync:vodsync@postgres:5432/vodsync

# ===== 调度 =====
# 源站列表刷新间隔（分钟）
SOURCE_REFRESH_INTERVAL_MINUTES=720
# 增量同步间隔（分钟）
SYNC_INTERVAL_MINUTES=360
# 同时真正在跑的源站同步数上限（全局闸门；超出的排队，不占数据库连接）
# NAS 建议 1-3：抓取是 IO 瓶颈，调太大只会让源站限速你
SOURCE_SYNC_CONCURRENCY=2
# 单源站并行抓取页数
PAGE_CONCURRENCY=4
# 请求间隔秒（防封）
REQUEST_INTERVAL_SECONDS=0.2
# 请求超时秒
REQUEST_TIMEOUT=20
# 失败重试次数
REQUEST_RETRIES=3
# 增量时检测缺失 ID（慢，默认关）
INCR_CHECK_MISSING=false
# 全量断点保存间隔（页）
CHECKPOINT_EVERY_PAGES=5
# 同一页最多重试次数（超过则中止本次全量并保留断点，避免对已挂源站空转）
PAGE_MAX_ATTEMPTS=3
# 增量索引阶段失败页重试之间的等待（秒）
PAGE_RETRY_SLEEP_SECONDS=2

# ===== 源站健康度退避（v1.8.1）=====
# 一轮同步「大面积失败」（索引/全量页失败率>=50% 或整轮异常）后，调度器按
# 60min → 2h → 4h → ... 指数退避跳过该站（封顶 24h），成功一次立即恢复。
# 手动点「增量/全量」不受退避限制。
BACKOFF_BASE_MINUTES=60
BACKOFF_MAX_HOURS=24
# 连续失败达到该次数后面板状态显示「离线」
FAIL_STATUS_DOWN_STREAK=2

# ===== 断电 / 重启恢复（v1.6.0）=====
# 启动时自动续跑「有断点但没跑完」的全量同步（断点、水位线一直都在库里，这里只管要不要自动接着跑）
AUTO_RESUME_ON_BOOT=true
# 延迟多少秒再开始续跑，让服务先把建库/条数校准/调度做完
AUTO_RESUME_DELAY_SECONDS=30

# ===== 中转代理（上游源站不可直连时自动降级）=====
# 是否启用：直连失败后自动按 PROXY_URLS 顺序尝试代理
PROXY_ENABLED=true
# 代理地址列表（逗号分隔），请求格式：{proxy}?url=<urlencode(目标地址)>
PROXY_URLS=https://pz.v88.qzz.io/,https://mconfig.viptv.work/
# 走代理时的单请求超时（秒）
PROXY_TIMEOUT=20
# 每个代理的最大并发请求数（避免打挂中转服务）
PROXY_CONCURRENCY=4
# "该源站需走代理"的记忆有效期（分钟），到期重试直连
PROXY_PREF_TTL_MINUTES=30

# ===== 数据库连接池 =====
# 连接池常驻连接数 / 峰值溢出连接数 / 等连接超时（秒）
# 等连接超时会返回 503（不是 500）：说明当前同步负载过高，减少并发或稍后重试
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=10
# 聚合搜索并行度（每个线程各占一个数据库连接）
SEARCH_CONCURRENCY=4

# ===== 多源列表查询（v1.7.0）=====
# 不带 source 查全部源站时，每张表各取 top-K 再在进程内归并（比 UNION 全量排序快一个量级）
# 每表最多参与归并的行数：决定能精确支持到第几页（3000 / 30 = 第 100 页），超过回退慢路径
MERGE_MAX_PER_TABLE=3000
# 归并查询并行度（每线程一个数据库连接，别超过 DB_POOL_SIZE）
MERGE_CONCURRENCY=4
# 列表 total 的缓存秒数（0 = 不缓存，每次请求都并行 count 全表）
TOTAL_CACHE_SECONDS=60
# 不带筛选条件的全站列表，total 直接用 SUM(sources.total_videos) 估值（v1.10.0）
# 省掉 52 张表各跑一次 count(*)（PG 上首次 1~3s）。响应会带 total_approximate=true；
# 带筛选（wd/type_id/年份）时仍走精确统计。设 false 可强制全部精确。
TOTAL_APPROXIMATE_ENABLED=true
# 分类清单缓存秒数（v1.10.0：分类几乎不变，避免每次对 52 张表 GROUP BY）
CATEGORIES_CACHE_SECONDS=300
# pg_trgm GIN 索引（v1.10.0）：让 name LIKE '%词%' 走索引，启动后台并发建表（不锁表）。
# 需要数据库允许 CREATE EXTENSION；没权限只记日志，搜索退化为顺序扫描（功能不变）。
PG_TRGM_ENABLED=true

# ===== 数据维护（v1.7.0）=====
# 是否启用定时清理（sync_logs）与 WAL checkpoint
HOUSEKEEPING_ENABLED=true
HOUSEKEEPING_INTERVAL_MINUTES=60
# 同步日志：保留天数 / 每源站最多条数 / 全表行数上限（running 行永不清理）
SYNC_LOG_RETENTION_DAYS=30
SYNC_LOG_KEEP_PER_SOURCE=50
SYNC_LOG_MAX_ROWS=20000

# ===== 访问控制（v1.5.0）=====
# 是否启用：面板需登录、API 需 Token。仅首次启动写入数据库，之后在面板「⚙ 设置」里改
AUTH_ENABLED=true
# 首次启动的管理面板密码（务必登录后改掉）
ADMIN_PASSWORD=666666
# 面板登录会话有效期（天）
SESSION_TTL_DAYS=7
# 连续登录失败锁定：N 次 / M 分钟
LOGIN_MAX_FAILS=5
LOGIN_LOCK_MINUTES=5
# 是否信任反代写入的 X-Forwarded-For。默认 false（该头可被客户端伪造，相信它=锁定形同虚设）
# 部署在 Nginx / Traefik / 群晖反向代理之后，且反代会覆盖 XFF，才改成 true
TRUST_PROXY=false
# 兼容项：设置后作为一枚额外有效的 Token（老客户端不用改配置）
API_KEY=

# ===== API =====
# 每页条数默认值（v1.14.0 / B-04 起固定 18，与客户端固定传的 page_size 对齐；
# 不一致会让「不传 page_size」的调用拿到不同 pagecount，翻页到底判断错位）
API_PAGE_SIZE_DEFAULT=18
API_PAGE_SIZE_MAX=100
# 成功响应的 code（v1.14.0 / B-11）。默认 0（契约值）；
# 灰度期若要退回 v1.13 的 MacCMS 风格，设成 1 重启即可，无需回退镜像。
# 注意：/api/v1/{slug} 兼容接口恒为 1，不受此项影响。
API_SUCCESS_CODE=0

# ===== 播放线路识别 / 过滤 / 排序（v1.11.0）=====
# 背景：部分源站（如非凡资源站，100% 记录如此）第 1 条线路是 H5 分享页 /share/<hash>，
# 返回 text/html，真实 m3u8 由页面 JS 生成且带会过期的 sign —— 播放器按顺序选第一条必然失败。
# 服务端在读接口上识别并剔除这类线路，vod_play_url 原始串不改写。
#
# 全局策略：off 不过滤（等价旧行为）/ filter 剔除分享页 / whitelist 只保留媒体直链
PLAY_LINE_POLICY=filter
# filter 模式下判为「不是播放地址」的路径特征（逗号分隔，大小写不敏感子串；
# 以 re: 开头的按正则）。只看 URL 的 path，不看 query。
# 注意：以 .m3u8/.mp4/.flv/.mkv 结尾的地址永远视为直链，不会被误杀
PLAY_LINE_DROP_PATTERNS=/share/,/play/,.html,.htm
# whitelist 模式保留的扩展名
PLAY_LINE_KEEP_EXT=m3u8,mp4,flv,mkv
# 直链优先排序（m3u8 > mp4 > flv > mkv > unknown > page，同类型内保持上游顺序）
PLAY_LINE_PREFER_DIRECT=true
# 线路名是否追加 provider：「线路2 (ffm3u8)」
PLAY_LINE_NAME_WITH_FROM=true
# 安全阀：过滤后线路数低于该值则整条影片回退未过滤结果（绝不允许过滤成「无线路」）
PLAY_LINE_MIN_KEEP=1
# 对 unknown 地址做一次 HEAD 探测（读路径上发网络请求，会拖慢详情；默认关）
PLAY_LINE_PROBE_HTML=false
PLAY_LINE_PROBE_TIMEOUT=1.5
# 源站级策略缓存秒数（面板改下拉会立即失效，这个只兜底多进程/直接改库）
PLAY_LINE_POLICY_CACHE_SECONDS=30

# ===== 能力清单（v1.14.0 / B-10）=====
# /healthz.capabilities 是客户端「能不能用 ?tag= 等新参数」的唯一判据。
# 灰度期单独关某项而不用改代码：CAPABILITIES_DISABLE=tag_search
CAPABILITIES_DISABLE=
# 仅排障用：强制声明某项能力（正常留空）
CAPABILITIES_EXTRA=

# ===== 标签精确检索（v1.14.0 / B-01）=====
# 详情页点标签 -> 「同标签影片」，按分词后精确匹配，而不是把标签当关键词模糊搜索。
# 数据落在 video_tags 倒排表，(tag_norm, source) 复合索引支撑。
TAG_SEARCH_ENABLED=true
# 同步入库时顺手维护倒排（关掉后只能靠全量回填，一般不需要关）
TAG_INDEX_ON_SYNC=true
# 启动时检查索引是否建完，没建完后台补齐（可断点续跑，建完的源站不重扫）
TAG_INDEX_ON_STARTUP=true
# 回填批大小与批间休眠：串行写、主动让路给同步任务（NAS 的 IO 很脆）
TAG_INDEX_BATCH=2000
TAG_INDEX_SLEEP_MS=50
# true = 忽略「索引是否建完」直接声明 tag_search（仅排障；生产别开）
TAG_SEARCH_FORCE=false
# 单次检索每个源站最多取多少条候选（超出翻页会回退 UNION，慢但保证不漏）
TAG_SEARCH_PER_SOURCE_LIMIT=500

# ===== Token 权限粒度（v1.14.0 / B-08，分阶段上线）=====
# 迁移铁律：先上线能力但**默认全放行**（等价全部 admin），客户端发版切到只读
# Token 之后，再打开强制校验。回滚：设回 false 重启，不用动数据。
TOKEN_SCOPE_ENFORCE=false
# 强制校验时，低于该版本的客户端一律按 admin 放行（老 App 不会整站 401）。
# 客户端用 X-Client-Version 头或 client_version 参数自报；不自报也放行（宽进严出）。
# 真正收紧时才填，例如 TOKEN_SCOPE_LEGACY_BELOW=1.6.0
TOKEN_SCOPE_LEGACY_BELOW=
# API_KEY 环境变量那枚 Token 的权限（默认 admin，保持既有部署行为）
API_KEY_SCOPE=admin

# ===== 其他 =====
DATA_DIR=/app/data
TZ=Asia/Shanghai

# ===== 相关推荐（v1.9.0，服务端预计算）=====
# 总开关（关闭后 /api/v1/related 返回实时兜底，不再预计算）
RELATED_ENABLED=true
# 算法版本：改动算法逻辑后递增此值，启动时自动清空旧结果并全量重算（读路径也按版本过滤）
#   1 = v1.9.x 纯权重重分配   2 = v1.10.0 证据先验+内容门控+演员余弦（默认）
RELATED_ALGO_VERSION=2
# 推荐条数（默认/上限）
RELATED_LIMIT_DEFAULT=12
RELATED_LIMIT_MAX=20
# 命中阈值：低于该分不进推荐列表；零命中时走兜底链（同分类→同地区年代→最新）
# 注意 v1.10.0 起分数带证据先验地板（约 0.2），调阈值收益有限，改用下面两个门控
RELATED_MIN_SCORE=0.15
# ---- 证据先验（v1.10.0）：缺失字段按缺失权重占比注入中性先验，稀疏数据不再自动封顶
#   prior = LAMBDA × (缺失权重/总权重)；score = (Σw·sim + prior·NEUTRAL) / (Σw + prior)
RELATED_EVIDENCE_PRIOR=0.6
RELATED_EVIDENCE_NEUTRAL=0.4
# ---- 内容信号门控（v1.10.0）：只有 标题/演员/导演/编剧 命中才算相似；
# 仅同分类+同地区+同年代的配对一律走兜底（m=fb），不再进推荐位
RELATED_REQUIRE_CONTENT_SIGNAL=true
# 标题相似度达到该值才算「内容信号」
RELATED_TITLE_CONTENT_MIN=0.15
# 可用权重下限：低于该值直接判无关（仅关掉内容门控时的兜底防线）
RELATED_MIN_EVIDENCE_WEIGHT=0.35
# 标题相似度双阈值（防两字短标题误伤）：LCS>=3字 或 Jaccard>=0.45 才计分
RELATED_TITLE_LCS_MIN=3
RELATED_TITLE_JACCARD_MIN=0.45
# 倒排候选上限 / 小表全量比较阈值 / 超大表轻量模式阈值
# v1.10.0 实测（1 万行整站）：cap 600→140 让重算 27.2s→6.0s，Top12 基本不变
RELATED_CANDIDATE_CAP=140
# 3000→400：旧阈值是性能悬崖（3000 行走 O(n²) 比 1 万行走倒排还慢）
RELATED_BRUTE_FORCE_MAX=400
RELATED_MAX_ROWS_PER_SOURCE=200000
# 每日校准（把过期/覆盖不满的源站重算一遍）
RELATED_CALIBRATION_DAYS=1
RELATED_CALIBRATION_HOUR=4
RELATED_CALIBRATION_MINUTE=30
RELATED_CALIBRATION_BUDGET=3
# 详情响应是否附带 related 数组（REST 详情与 ac=detail，纯新增字段）
RELATED_IN_DETAIL=true
# 基础权重表：字段齐全时的理想占比（v1.10.0 起不再「摊分给其余项」，改为证据先验）
# 标题是唯一全量信号 → 0.35；分类 52 站共用十几个大类，区分度低 → 0.15
RELATED_WEIGHTS=class:0.15,actor:0.20,director:0.05,writer:0.05,area:0.05,year:0.05,title:0.35
# 占位值表（演职员/地区/年代命中即视为缺失）
RELATED_PLACEHOLDERS=内详,未知,暂无,暂缺,不详,无,待定,待补,更多,点击查看,角色介绍,n/a,na,tba,none,null,-,—,/,0
# 标题噪声剥离（逗号分隔的正则，逐条依次替换）
RELATED_NOISE_PATTERNS=见 config.py 默认值（含括号标注/国语/4K/HD/第x季/终章等）
# 年代差惩罚（翻拍/同名不同片）：年份差>N年 → 标题分×系数
RELATED_YEAR_GAP_PENALTY_YEARS=6
RELATED_YEAR_GAP_FACTOR=0.6
# 年代相邻得分（差1年=同系列续作）
RELATED_YEAR_ADJACENT_SCORE=0.5
# 序号不一致（季1 vs 季2）时标题分乘的系数
RELATED_ORDINAL_MISMATCH_FACTOR=0.5
# 明星词库推断模式：off / when_missing（默认，仅缺失演员的视频）/ always
RELATED_STAR_INFER_MODE=when_missing
# 强推断判定：标题命中词库且 area/year/type 非空数<=该值 → 不打折
RELATED_STAR_STRONG_MAX_FIELDS=1
# 弱推断（仅简介命中/字段齐全时标题命中）相似度系数
RELATED_STAR_SIM_FACTOR=0.7
# 标题否定词（v1.10.0）：命中则强制降为弱信号（访谈/花絮/盘点/预告 等不是主演作品）
# RELATED_STAR_NEGATIVE_PATTERNS=访谈,专访,花絮,幕后,解说,盘点,合集,混剪,预告,同款,致敬,恶搞,吐槽,影评,reaction,采访,纪录片
# 兜底链条数上限（v1.10.0）：零命中时最多补几条「猜你想看」（旧版一次补满 12 条）
RELATED_FALLBACK_LIMIT=6
# 重算并发闸门（v1.10.0）：全局最多几个源站同时整站重算（超出排队），防内存叠加
RELATED_RECOMPUTE_CONCURRENCY=2
# 增量重算合并窗口（秒）：窗口内多次 touched 合并成一次（0 = 关闭，退回旧行为）
RELATED_INCREMENT_DEBOUNCE_SECONDS=60
# 窗口内累计 id 超过「源站行数 × 该比例」时直接整站重算
RELATED_INCREMENT_FULL_RATIO=0.3

# ===== 存量字段回填（v1.9.0）=====
# 升级前已同步的库没有演员/地区/年代列，每晚凌晨对缺字段的源站重跑全量（UPSERT 幂等只补字段）
FIELD_BACKFILL_ENABLED=true
FIELD_BACKFILL_SOURCES_PER_NIGHT=2
FIELD_BACKFILL_START_HOUR=2

# ===== 明星 Tag 回填 + 明星作品推荐（v1.9.1）=====
# 同步完成后自动回填：全量同步→整站重建；增量同步→只重算本轮 touched 的视频
STAR_TAG_AUTO_AFTER_SYNC=true
# 每晚定时重建预算（小站优先；重建全量幂等，词库增删后历史行会被重新评估）
STAR_TAG_NIGHTLY_BUDGET=2
STAR_TAG_NIGHTLY_HOUR=3
STAR_TAG_NIGHTLY_MINUTE=40
# 重建时清掉「旧推断残留」tag（v1.10.0）：缺演员行每次按当前词库重算，
# 命中则写入、不命中则清空（否则词库删改后旧值永久残留且洗不掉）
STAR_TAG_CLEAR_STALE=true
# 同一源站两次夜间重建的最小间隔（小时，配合轮转保证每个源站都轮到）
STAR_TAG_NIGHTLY_MIN_INTERVAL_HOURS=20
# 单视频最多写入的明星数（防溢出 vod_tag VARCHAR(255)）
STAR_TAG_MAX_PER_VIDEO=5
# 扫描批大小（keyset 分页步长）
STAR_TAG_BATCH_SIZE=2000
# 明星相关视频 API 条数
STAR_RELATED_LIMIT_DEFAULT=20
STAR_RELATED_LIMIT_MAX=50
# 按明星查作品 API（v1.9.2）默认/上限条数
STAR_WORKS_LIMIT_DEFAULT=30
STAR_WORKS_LIMIT_MAX=100
# 未入词库高频词统计（v1.9.2，扩词库用）
STAR_UNTRACKED_SAMPLE=20000
STAR_UNTRACKED_MIN_COUNT=3
# 停用词（逗号分隔，命中即过滤；默认已含 电影/电视剧/全集/第/季/集 等）
# STAR_UNTRACKED_STOPWORDS=电影,电视剧,全集,完整版,高清,国语

# ===== 未成年模式（v1.15.0）=====
# 默认 false：只有客户端请求带 X-Minor-Mode: 1 / ?minor_mode=1 时才屏蔽
#   sources.is_adult=1 的源站；不带开关的现有调用行为与 v1.14.1 完全一致。
# 设 true：服务端对所有请求强制生效，客户端无法通过不带头绕过（家长统一管控）。
# 标记为「是」的源站在管理面板「源站管理」→「18+ 内容」列逐站设置。
MINOR_MODE_FORCE=false
