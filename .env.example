# ===== 数据源 =====
# 资源站列表地址
LATEST_JSON_URL=https://mylazily.github.io/ziyuanzhan/data/latest.json
# 只同步 status=ok 的源站
ONLY_OK_SOURCES=true
# 发现新源站后立即全量同步
FULL_SYNC_ON_DISCOVER=true

# ===== 数据库 =====
# 默认 SQLite（文件在 DATA_DIR 下）
# DATABASE_URL=sqlite:////app/data/vodsync.db
# PostgreSQL 示例：
# DATABASE_URL=postgresql+psycopg2://vodsync:vodsync@postgres:5432/vodsync

# ===== 调度 =====
# 源站列表刷新间隔（分钟）
SOURCE_REFRESH_INTERVAL_MINUTES=720
# 增量同步间隔（分钟）
SYNC_INTERVAL_MINUTES=360
# 并行同步的源站数
SOURCE_SYNC_CONCURRENCY=2
# 单源站并行抓取页数
PAGE_CONCURRENCY=4
# 请求间隔秒（防封）
REQUEST_INTERVAL_SECONDS=0.2
# 请求超时秒
REQUEST_TIMEOUT=20
# 失败重试次数
REQUEST_RETRIES=3
# 增量时检测缺失 ID（慢，默认关）
INCR_CHECK_MISSING=false
# 全量断点保存间隔（页）
CHECKPOINT_EVERY_PAGES=5

# ===== 中转代理（上游源站不可直连时自动降级）=====
# 是否启用：直连失败后自动按 PROXY_URLS 顺序尝试代理
PROXY_ENABLED=true
# 代理地址列表（逗号分隔），请求格式：{proxy}?url=<urlencode(目标地址)>
PROXY_URLS=https://pz.v88.qzz.io/,https://mconfig.viptv.work/
# 走代理时的单请求超时（秒）
PROXY_TIMEOUT=20
# 每个代理的最大并发请求数（避免打挂中转服务）
PROXY_CONCURRENCY=4
# "该源站需走代理"的记忆有效期（分钟），到期重试直连
PROXY_PREF_TTL_MINUTES=30

# ===== API =====
API_PAGE_SIZE_DEFAULT=20
API_PAGE_SIZE_MAX=100
# 留空=不鉴权；设置后所有接口需携带 X-API-Key 请求头或 ?apikey= 参数
API_KEY=

# ===== 其他 =====
DATA_DIR=/app/data
TZ=Asia/Shanghai
